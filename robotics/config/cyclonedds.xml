<?xml version="1.0" encoding="UTF-8" ?>
<!-- ARCADIA: everything runs on one laptop. Pin CycloneDDS to loopback so Wi-Fi address changes,
     sleep/resume or VPNs can never stall the ROS 2 graph (unicast writes to a vanished IP). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="true" priority="default"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
