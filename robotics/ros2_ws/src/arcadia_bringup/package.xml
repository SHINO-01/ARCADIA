<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arcadia_bringup</name>
  <version>0.1.0</version>
  <description>Launch files: Webots (native, streaming) + supervisor + fleet controllers + telemetry throttle + diagnostics + rosbridge.</description>
  <maintainer email="shachcha01@gmail.com">ARCADIA</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>arcadia_sim</exec_depend>
  <exec_depend>arcadia_supervisor</exec_depend>
  <exec_depend>arcadia_msgs</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
