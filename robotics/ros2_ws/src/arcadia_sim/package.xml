<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arcadia_sim</name>
  <version>0.1.0</version>
  <description>ARCADIA Webots world, robot controllers (rclpy extern controllers), telemetry throttle and diagnostics.</description>
  <maintainer email="shachcha01@gmail.com">ARCADIA</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>arcadia_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ros2launch</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
