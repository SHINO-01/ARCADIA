#VRML_SIM R2025a utf8
# ARCADIA digital-twin world. Deliberately minimal: the C++ supervisor procedurally spawns the
# farm (terrain plane, hex crops, docks, storage, robots) from the backend's world-config JSON.

IMPORTABLE EXTERNPROTO "../protos/ArcadiaUGV.proto"
IMPORTABLE EXTERNPROTO "../protos/ArcadiaAGV.proto"
IMPORTABLE EXTERNPROTO "../protos/ArcadiaUAV.proto"

WorldInfo {
  title "ARCADIA farm"
  info [ "Project ARCADIA - autonomous agricultural digital twin" ]
  basicTimeStep 32
  FPS 30
  optimalThreadCount 2
  coordinateSystem "ENU"
  contactProperties [
    ContactProperties { material1 "default" material2 "default" coulombFriction [ 1.2 ] softCFM 0.001 }
  ]
}
DEF VIEWPOINT Viewpoint {
  orientation 1 0 0 0.95
  position 0 -220 160
  follow ""
  followType "Pan and Tilt Shot"
  near 2
}
# Plain sky + sun: no HDR cube maps to stream to the browser viewer, cheap on integrated graphics
Background {
  skyColor [ 0.64 0.79 0.93 ]
  luminosity 0.9
}
DirectionalLight {
  direction -0.4 -0.5 -1
  intensity 1.8
  castShadows FALSE
}
DEF GROUND Solid {
  name "ground"
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.42 0.31 0.18 roughness 1 metalness 0 }
      geometry DEF GROUND_PLANE Plane { size 600 600 }
    }
  ]
  boundingObject Plane { size 600 600 }
  locked TRUE
}
DEF SUPERVISOR Robot {
  name "arcadia_supervisor"
  controller "<extern>"
  supervisor TRUE
  children [ Receiver { name "rx" } ]
}
DEF FARM Group {
  children [ ]
}
