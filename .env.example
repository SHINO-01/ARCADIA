# ---- web stack (docker compose) ----
POSTGRES_PASSWORD=arcadia
POSTGRES_PORT=55432
REDIS_PORT=6379
HTTP_PORT=8080
HTTPS_PORT=8443

# Bridge: auto = use native ROS 2 via rosbridge when reachable, else the headless digital twin
ARCADIA_BRIDGE_MODE=auto
ARCADIA_ROSBRIDGE_URL=ws://host.docker.internal:9090

# Sim agent (scripts/sim_agent.sh, native): Webots window (true) or minimised (false), and how long
# the web stack may be down before the simulation is stopped
ARCADIA_SIM_GUI=true
ARCADIA_SIM_GRACE_S=45
ARCADIA_CHAOS_ENABLED=true
ARCADIA_CHAOS_INTERVAL_S=180
ARCADIA_MAX_ACTIVE_ROBOTS=2
ARCADIA_DEFAULT_ROBOTS=scout_uav,seeder_ugv
ARCADIA_LOG_LEVEL=INFO

# ---- frontend (build-time) ----
# Optional: Mapbox satellite imagery. Leave empty to use the free Esri World Imagery basemap.
VITE_MAPBOX_TOKEN=
# Empty = same origin (/webots-stream through Caddy); set ws://localhost:1234 to bypass the proxy
VITE_WEBOTS_STREAM_URL=
